# Environment for the SSI Portainer stacks (deploy/ssi). Copy the values into
# the stack's "Environment variables" in Portainer (Advanced mode lets you paste
# this whole file). Never commit real values.

# --- Public addresses ---------------------------------------------------------
# Set in the compose files: wallet https://wallet.zdevutils.com, market
# https://market-empower-x.zdevutils.com, node http://192.168.130.2:8000 (LAN).
# DNS for wallet.zdevutils.com must point at the host running nginx-proxy.
# Same email the other stacks use for Let's Encrypt.
LETSENCRYPT_EMAIL=
# Network nginx-proxy / acme-companion watch (same one the marketplace uses).
PROXY_NETWORK=docker_default

# --- Ocean node -> Policy Server ------------------------------------------------
# Set POLICY_SERVER_BIND to this host's LAN IP so the port is not exposed on
# public interfaces. The node uses POLICY_SERVER_URL=http://<LAN-IP>:<PORT>.
POLICY_SERVER_BIND=0.0.0.0
POLICY_SERVER_PORT=8011

# --- Secrets: generate with `node deploy/ssi/scripts/generate-secrets.mjs` ----
WALLET_ENCRYPTION_KEY=
WALLET_SIGN_KEY=
WALLET_TOKEN_KEY=
WALLET_PEPPER=
WALLET_AUTHNZ_JWK=
DB_PASSWORD=

# --- Tools stack only (docker-compose.tools.yml) ------------------------------
# LAN IP of this host: admins open http://<TOOLS_HOST>:7102 to issue credentials.
TOOLS_HOST=192.168.130.x
# Interface the tools are published on (use the LAN IP, never 0.0.0.0 on a
# host with a public interface).
TOOLS_BIND=127.0.0.1

# --- Image versions (defaults are the tested combination) ---------------------
# POLICY_SERVER_VERSION=v1.3.2   # v1.3.3+ requires Ocean Node 4.x
# WALLET_API_VERSION=gaiax-0.1.1-OE
# VERIFIER_API_VERSION=gaiax-0.1.2-OE
# DEV_WALLET_VERSION=gaiax-0.1.5-OE
# OPA_VERSION=1.4.2
# ISSUER_API_VERSION=0.23.2
# PORTAL_VERSION=0.15.1
